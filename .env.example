# Client (VITE_ prefix - inlined into the browser bundle at build time, so only
# safe/expected-to-be-public values belong here)
VITE_GOOGLE_AUTH_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_PLACE_API_KEY=your-google-places-api-key
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# Server-only (no VITE_ prefix - never bundled into the client, read only by the
# /api/* serverless functions). Set these in the Vercel project's Environment
# Variables settings, not just locally.
GOOGLE_GEMINI_AI_API_KEY=your-google-gemini-api-key
GOOGLE_PLACE_API_KEY=your-google-places-api-key
